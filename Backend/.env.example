# --- Groq API keys (rotated automatically) ------------------------------
# Add as many as you like: GROQ_API_KEY_1 ... GROQ_API_KEY_20
GROQ_API_KEY_1=
# GROQ_API_KEY_2=

# --- Optional models ----------------------------------------------------
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_CODING_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# --- Access control -----------------------------------------------------
# Shared secret. Set it here AND in the frontend <meta name="rexwork-token">.
# If empty, the backend only accepts browser requests from the origins in
# ALLOWED_ORIGINS (plus *.vercel.app and localhost).
APP_TOKEN=

# Comma separated origin allow-list used when APP_TOKEN is empty.
# ALLOWED_ORIGINS=https://rexworks.vercel.app,http://localhost:8000
